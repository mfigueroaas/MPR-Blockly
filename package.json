{
  "name": "mpr-blockly",
  "productName": "MPR Blockly",
  "version": "1.6.0",
  "description": "MPR Blockly (Mi Primer Robot): programación por bloques para robots Otto DIY, basado en Otto Blockly",
  "author": "Programa Mi Primer Robot / Otto DIY and Builder community",
  "license": "GPL-2.0",
  "main": "electronApp.js",
  "repository": {
    "type": "git",
    "url": "https://github.com/Admin-Proteinlab/blockly_mpr.git"
  },
  "scripts": {
    "start": "electron .",
    "installer": "python tools/build_installer.py --official ottoblockly.Setup.1.5.0.exe",
    "rebuild": "electron-rebuild -f -w serialport -v 4.1.1",
    "postinstall": "electron-rebuild -f -w serialport -v 4.1.1"
  },
  "devDependencies": {
    "electron": "4.1.1",
    "electron-rebuild": "1.11.0"
  },
  "dependencies": {
    "serialport": "7.1.4"
  }
}
