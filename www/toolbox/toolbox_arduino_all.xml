<?xml version="1.0" encoding="utf-8" ?>
<toolbox>
	<!-- Categorías visibles en el menú, en este orden (blocklino.js, buildToolbox). Los ids deben existir abajo. -->
	<parametre id="defaultCategories1">CAT_ARDUINO,CAT_OTTO,CAT_BUZZER,CAT_ultrason,CAT_ARDUINO_TIME,CAT_LOGIC,CAT_MATH,CAT_FUNCTIONS,CAT_VARIABLES</parametre>

	<category name="CAT_ARDUINO" colour="#2d2d64">
		<block type="base_setup_loop"></block>
		<block type="base_setup"></block>
		<block type="base_loop"></block>
		<block type="base_define"></block>
		<block type="base_code"></block>
		<block type="base_code_entree"></block>
	</category>

	<category name="CAT_OTTO" colour="#4759F5">
		<block type="otto_configuration">
			<field name="PIN_YL">2</field>
			<field name="PIN_YR">3</field>
			<field name="PIN_RL">4</field>
			<field name="PIN_RR">5</field>
			<field name="PIN_Buzzer">13</field>
		</block>
		<block type="otto_home"></block>
		<block type="otto_move"></block>
		<block type="otto_dance"></block>
		<block type="otto_do"></block>
		<block type="otto_gesture"></block>
		<block type="otto_detener"></block>
		<block type="otto_movelegs">
			<value name="PIN_YL"><shadow type="inout_angle_maths"><field name="NUM">90</field></shadow></value>
			<value name="PIN_YR"><shadow type="inout_angle_maths"><field name="NUM">90</field></shadow></value>
			<value name="PIN_RL"><shadow type="inout_angle_maths"><field name="NUM">90</field></shadow></value>
			<value name="PIN_RR"><shadow type="inout_angle_maths"><field name="NUM">90</field></shadow></value>
			<value name="TEMPO"><shadow type="math_number"><field name="NUM">200</field></shadow></value>
		</block>
	</category>

	<category name="CAT_BUZZER" colour="#FF63BB">
		<block type="otto_sound"></block>
		<block type="otto_tone"></block>
		<!-- MPR: el bloque Hz venía con 10 Hz (no suena) y 261 en la duración: ahora Do4 (262 Hz) por medio segundo. -->
		<block type="otto_tonehz">
			<value name="Hz1"><shadow type="math_number"><field name="NUM">262</field></shadow></value>
			<value name="duration"><shadow type="math_number"><field name="NUM">500</field></shadow></value>
			<value name="silent"><shadow type="math_number"><field name="NUM">100</field></shadow></value>
		</block>
		<block type="otto_bendtone">
			<value name="Hz1"><shadow type="math_number"><field name="NUM">880</field></shadow></value>
			<value name="Hz2"><shadow type="math_number"><field name="NUM">2093</field></shadow></value>
			<value name="prop"><shadow type="math_number"><field name="NUM">1.02</field></shadow></value>
			<value name="duration"><shadow type="math_number"><field name="NUM">18</field></shadow></value>
			<value name="silent"><shadow type="math_number"><field name="NUM">1</field></shadow></value>
		</block>
		<block type="RTTTL_music_lat"><field name="PIN_BUZZER">13</field></block>
		<block type="RTTTL_music"><field name="PIN_BUZZER">13</field></block>
		<block type="RTTTL_music_custom">
			<field name="PIN_BUZZER">13</field>
			<value name="rtttl_melody"><shadow type="text"><field name="TEXT">text</field></shadow></value>
		</block>
		<block type="play">
			<value name="PIN"><shadow type="analog_pin"><field name="NUM">13</field></shadow></value>
		</block>
		<block type="tone">
			<value name="PIN"><shadow type="analog_pin"><field name="NUM">13</field></shadow></value>
			<value name="NUM"><shadow type="math_number"><field name="NUM">880</field></shadow></value>
			<value name="TPS"><shadow type="math_number"><field name="NUM">100</field></shadow></value>
		</block>
		<block type="notone">
			<value name="PIN"><shadow type="analog_pin"><field name="NUM">13</field></shadow></value>
		</block>
		<block type="beep">
			<value name="PIN"><shadow type="analog_pin"><field name="NUM">13</field></shadow></value>
		</block>
	</category>

	<category name="CAT_ultrason" colour="#54BCF7">
		<block type="ultrasonic_sensor">
			<field name="PIN_TRIG">8</field>
			<field name="PIN_ECHO">9</field>
		</block>
		<block type="ultrasonic_distance"></block>
	</category>

	<category name="CAT_ARDUINO_TIME" colour="#00929f">
		<block type="base_delay">
			<value name="DELAY_TIME"><shadow type="math_number"><field name="NUM">1</field></shadow></value>
		</block>
		<block type="tempo_sans_delay">
			<value name="DELAY_TIME"><shadow type="math_number"><field name="NUM">1</field></shadow></value>
		</block>
		<block type="millis"></block>
		<block type="inout_pulsein"><value name="PIN"><shadow type="analog_pin"><field name="NUM">10</field></shadow></value></block>
	</category>

	<category name="CAT_LOGIC" colour="#FFBD3B">
		<block type="controls_if"></block>
		<block type="controls_repeat_ext"><value name="TIMES"><shadow type="math_number"><field name="NUM">2</field></shadow></value></block>
		<block type="controls_whileUntil"></block>
		<block type="controls_for">
			<value name="FROM"><shadow type="math_number"><field name="NUM">0</field></shadow></value>
			<value name="TO"><shadow type="math_number"><field name="NUM">5</field></shadow></value>
			<value name="BY"><shadow type="math_number"><field name="NUM">1</field></shadow></value>
		</block>
		<block type="controls_switch"></block>
		<block type="controls_flow_statements"></block>
		<block type="logic_operation"></block>
		<block type="logic_negate"></block>
		<block type="logic_null"></block>
	</category>

	<category name="CAT_MATH" colour="#00D072">
		<block type="math_number"></block>
		<block type="inout_angle_maths"></block>
		<block type="analog_pin"></block>
		<block type="math_arithmetic"></block>
		<block type="logic_compare">
			<value name="B"><shadow type="math_number"><field name="NUM">10</field></shadow></value>
		</block>
		<block type="intervalle"></block>
		<block type="math_map">
			<value name="A1"><shadow type="math_number"><field name="NUM">0</field></shadow></value>
			<value name="A2"><shadow type="math_number"><field name="NUM">1023</field></shadow></value>
			<value name="B1"><shadow type="math_number"><field name="NUM">0</field></shadow></value>
			<value name="B2"><shadow type="math_number"><field name="NUM">10</field></shadow></value>
		</block>
		<block type="math_modulo"></block>
		<block type="math_random_int">
			<value name="FROM"><shadow type="math_number"><field name="NUM">0</field></shadow></value>
			<value name="TO"><shadow type="math_number"><field name="NUM">99</field></shadow></value>
		</block>
		<block type="math_constrain">
			<value name="LOW"><shadow type="math_number"><field name="NUM">0</field></shadow></value>
			<value name="HIGH"><shadow type="math_number"><field name="NUM">100</field></shadow></value>
		</block>
		<block type="math_single"></block>
		<block type="math_round"></block>
		<block type="math_trig"></block>
		<block type="math_constant"></block>
		<block type="math_number_property"></block>
	</category>

	<category name="CAT_FUNCTIONS" custom="PROCEDURE" colour="#FF6680"></category>

	<category name="CAT_VARIABLES" custom="VARIABLE" colour="#FF8900"></category>

	<!-- MPR: categoría del modo monitor (Ctrl + Mayús + M, js/mpr_monitor.js). No va en defaultCategories1: blocklino.js
	     (buildToolbox) la agrega al final del menú solo con el modo activo. Sin comentarios dentro de los <block>. -->
	<category name="CAT_MPR_MONITOR" colour="#0060aa">
		<label text="Mostrar en el Monitor Serie"></label>
		<block type="serial_init"><field name="PINBAUDIOS">9600</field></block>
		<block type="mpr_mostrar">
			<field name="NOMBRE">distancia</field>
			<value name="VALOR"><shadow type="math_number"><field name="NUM">0</field></shadow></value>
		</block>
		<block type="serial_println">
			<value name="CONTENT"><shadow type="text"><field name="TEXT">Hola</field></shadow></value>
		</block>
		<block type="serial_print">
			<value name="CONTENT"><shadow type="text"><field name="TEXT">Hola</field></shadow></value>
		</block>
		<block type="text"><field name="TEXT">Hola</field></block>
		<block type="text_join">
			<value name="ADD0"><shadow type="text"><field name="TEXT">Otto: </field></shadow></value>
			<value name="ADD1"><shadow type="text"><field name="TEXT">listo</field></shadow></value>
		</block>
		<label text="Medir"></label>
		<block type="mpr_bateria"></block>
		<block type="millis"><field name="unite">m</field></block>
		<block type="inout_digital_read"><field name="PIN">10</field></block>
		<block type="inout_analog_read"><field name="broche">A0</field></block>
		<label text="Recibir órdenes del Monitor Serie"></label>
		<block type="serial_available"></block>
		<block type="serial_read_number"><field name="LOGIC">TRUE</field></block>
		<block type="serial_read_string"><field name="LOGIC">TRUE</field></block>
	</category>

</toolbox>
